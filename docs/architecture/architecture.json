  "flows": [
    {
      "id": "chat-turn",
      "name": "A chat turn that reaches the agent",
      "description": "A question that passes the guardrail and misses the cache. Every step is streamed to the activity panel as an SSE tool-call or tool-result event.",
      "steps": [
        {"from": "chat-ui", "to": "chat-pipeline", "msg": "POST /api/chat/stream (thread_id, messages)", "kind": "call"},
        {"from": "chat-pipeline", "to": "semantic-router", "msg": "embed + check prompt against routes", "kind": "call"},
        {"from": "semantic-router", "to": "chat-pipeline", "msg": "allowed", "kind": "return"},
        {"from": "chat-pipeline", "to": "langcache", "msg": "POST /entries/search", "kind": "call"},
        {"from": "langcache", "to": "chat-pipeline", "msg": "miss", "kind": "return"},
        {"from": "chat-pipeline", "to": "agent-memory", "msg": "add user event, get session, search long-term", "kind": "call"},
        {"from": "chat-pipeline", "to": "langgraph-agent", "msg": "prompt + retrieved memory context", "kind": "call"},
        {"from": "langgraph-agent", "to": "openai", "msg": "messages + tool definitions", "kind": "call"},
        {"from": "langgraph-agent", "to": "context-retriever", "msg": "query_tool(MCP_AGENT_KEY, tool, args)", "kind": "call"},
        {"from": "context-retriever", "to": "redis", "msg": "search domain entities", "kind": "call"},
        {"from": "langgraph-agent", "to": "chat-pipeline", "msg": "final answer, streamed as text-delta", "kind": "return"},
        {"from": "chat-pipeline", "to": "agent-memory", "msg": "add assistant event to the session", "kind": "call"}
      ]
    },
    {
      "id": "short-circuits",
      "name": "Guardrail block and cache hit",
      "description": "The two ways a turn ends before the agent runs, so no chat model call is made.",
      "steps": [
        {"from": "chat-ui", "to": "chat-pipeline", "msg": "POST /api/chat/stream", "kind": "call"},
        {"from": "chat-pipeline", "to": "semantic-router", "msg": "check(prompt vector)", "kind": "call"},
        {"from": "semantic-router", "to": "redis", "msg": "nearest route reference", "kind": "call"},
        {"from": "semantic-router", "to": "chat-pipeline", "msg": "blocked route + block message", "kind": "return"},
        {"from": "chat-pipeline", "to": "chat-ui", "msg": "canned reply, done (guardrailBlocked)", "kind": "return"},
        {"from": "chat-pipeline", "to": "chat-pipeline", "msg": "otherwise, if allowed", "kind": "note"},
        {"from": "chat-pipeline", "to": "langcache", "msg": "POST /entries/search", "kind": "call"},
        {"from": "langcache", "to": "chat-pipeline", "msg": "hit: cached response + similarity", "kind": "return"},
        {"from": "chat-pipeline", "to": "chat-ui", "msg": "cached reply, done (cacheHit)", "kind": "return"}
      ]
    },
    {
      "id": "make-setup",
      "name": "make setup for a domain",
      "description": "First run or a domain switch. make reset skips model generation and reuses the data files.",
      "steps": [
        {"from": "presenter", "to": "setup-scripts", "msg": "make setup DOMAIN=<id>", "kind": "call"},
        {"from": "setup-scripts", "to": "domain-pack", "msg": "generate models + synthetic JSONL from schema", "kind": "call"},
        {"from": "setup-scripts", "to": "redis", "msg": "delete every key except memory:*", "kind": "call"},
        {"from": "setup-scripts", "to": "context-retriever", "msg": "create surface: data model + Redis creds (admin key)", "kind": "call"},
        {"from": "context-retriever", "to": "setup-scripts", "msg": "surface id + agent key, written to .env", "kind": "return"},
        {"from": "setup-scripts", "to": "context-retriever", "msg": "import_data in batches of 25", "kind": "call"},
        {"from": "context-retriever", "to": "redis", "msg": "write records + create indexes", "kind": "call"},
        {"from": "setup-scripts", "to": "agent-memory", "msg": "clear, then seed long-term memories", "kind": "call"},
        {"from": "setup-scripts", "to": "langcache", "msg": "flush, then seed cached responses", "kind": "call"}
      ]
    }
  ]
